{
  "expo": {
    "name": "Family OS",
    "slug": "family-os-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "family-os",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "backgroundColor": "#F4F6F8", "resizeMode": "contain" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.familyos" },
    "android": { "package": "app.familyos", "adaptiveIcon": { "backgroundColor": "#F4F6F8" } },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router", "expo-localization", "expo-secure-store", "expo-font", "expo-web-browser"],
    "experiments": { "typedRoutes": false }
  }
}
